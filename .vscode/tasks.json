{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "holostudio: install",
      "type": "shell",
      "command": "py -3.13 -m venv .venv; .venv/Scripts/python.exe -m pip install -r requirements-dev.txt",
      "options": { "cwd": "${workspaceFolder}/desktop" },
      "problemMatcher": []
    },
    {
      "label": "holostudio: gate (lint + test)",
      "type": "shell",
      "command": ".venv/Scripts/python.exe -m ruff check . ; .venv/Scripts/python.exe -m pytest",
      "options": { "cwd": "${workspaceFolder}/desktop" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "holostudio: run",
      "type": "shell",
      "command": ".venv/Scripts/python.exe run.py",
      "options": { "cwd": "${workspaceFolder}/desktop" },
      "problemMatcher": []
    }
  ]
}
