{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "holostudio: cài đặt máy mới",
      "detail": "Cài Python 3.13, thư viện, model, kernel Jupyter và extension VS Code (không cần cài gì trước)",
      "type": "process",
      "command": "${workspaceFolder}/desktop/setup.cmd",
      "options": {
        "cwd": "${workspaceFolder}/desktop"
      },
      "problemMatcher": []
    },
    {
      "label": "holostudio: install",
      "type": "shell",
      "command": ".\\setup.cmd -SkipExtensions",
      "options": {
        "cwd": "${workspaceFolder}/desktop"
      },
      "problemMatcher": [],
      "detail": "Cài lại thư viện, model và kernel (không đụng extension VS Code)"
    },
    {
      "label": "holostudio: gate (lint + test)",
      "type": "shell",
      "command": ".venv/Scripts/python.exe -m ruff check . ; .venv/Scripts/python.exe -m pytest",
      "options": {
        "cwd": "${workspaceFolder}/desktop"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "holostudio: run",
      "type": "shell",
      "command": ".venv/Scripts/python.exe run.py",
      "options": {
        "cwd": "${workspaceFolder}/desktop"
      },
      "problemMatcher": []
    }
  ]
}
